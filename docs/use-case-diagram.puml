@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EAF2F8
  BorderColor #315A78
  ArrowColor #315A78
}

actor "Laboratory Staff /\nEquipment Custodian" as Staff

rectangle "Campus Equipment Borrowing System" {
  package "Inventory browsing" {
    usecase "UC-01\nView Equipment Catalog" as UC01
    usecase "UC-02\nFind Available Equipment" as UC02
  }
  package "Checkout and returns" {
    usecase "UC-03\nBorrow Equipment" as UC03
    usecase "UC-04\nView Active Borrowings" as UC04
    usecase "UC-05\nReturn Equipment" as UC05
    usecase "UC-06\nCheck Out Multiple\nEquipment Items" as UC06
  }
  package "History and retrieval" {
    usecase "UC-07\nView Student Borrowing History" as UC07
    usecase "UC-08\nView Equipment Borrowing History" as UC08
    usecase "UC-09\nSearch, Filter, and Sort Borrowings" as UC09
  }
  package "Student management" {
    usecase "UC-12\nRegister Student" as UC12
    usecase "UC-13\nUpdate Student Information" as UC13
    usecase "UC-14\nChange Borrowing Eligibility" as UC14
  }
  package "Equipment management" {
    usecase "UC-15\nRegister Equipment" as UC15
    usecase "UC-16\nUpdate Equipment Information" as UC16
  }
}

Staff --> UC01
Staff --> UC02
Staff --> UC03
Staff --> UC04
Staff --> UC05
Staff --> UC06
Staff --> UC07
Staff --> UC08
Staff --> UC09
Staff --> UC12
Staff --> UC13
Staff --> UC14
Staff --> UC15
Staff --> UC16
@enduml
